{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gander-pl-next",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-08",
	"build": {
		"command": "npm run build:shallow"
	},
	"assets": {
		"directory": ".vitepress/dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		// Run the Worker only for pages (CSP nonce); /assets/* and files with an extension stay free static requests.
		"run_worker_first": [
			"/*",
			"!/assets/*",
			"!/*.*"
		]
	},
	"previews": {}
}
